<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. The tracker database and its settings reference SAF grants that do not survive a restore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="tracker.db" />
        <exclude domain="database" path="tracker.db-wal" />
        <exclude domain="database" path="tracker.db-shm" />
        <exclude domain="database" path="tracker.db-journal" />
        <exclude domain="file" path="datastore/tracker_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="tracker.db" />
        <exclude domain="database" path="tracker.db-wal" />
        <exclude domain="database" path="tracker.db-shm" />
        <exclude domain="database" path="tracker.db-journal" />
        <exclude domain="file" path="datastore/tracker_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
