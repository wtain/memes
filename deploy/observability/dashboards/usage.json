{
  "uid": "memes-usage",
  "title": "Memes - Usage",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "tags": [
    "memes",
    "observability"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "metal,general,it",
        "current": {
          "selected": true,
          "text": "metal",
          "value": "metal"
        },
        "options": [
          {
            "selected": true,
            "text": "metal",
            "value": "metal"
          },
          {
            "selected": false,
            "text": "general",
            "value": "general"
          },
          {
            "selected": false,
            "text": "it",
            "value": "it"
          }
        ],
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Calls per route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "memes-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "memes-prometheus"
          },
          "expr": "sum by (route) (rate(http_requests_total{env=\"$env\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Calls by status class",
      "description": "",
