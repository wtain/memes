{
  "uid": "memes-performance",
  "title": "Memes - Performance",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "tags": [
    "memes",
    "observability"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "metal,general,it",
        "current": {
          "selected": true,
          "text": "metal",
          "value": "metal"
        },
        "options": [
          {
            "selected": true,
            "text": "metal",
            "value": "metal"
          },
          {
            "selected": false,
            "text": "general",
            "value": "general"
          },
          {
            "selected": false,
            "text": "it",
            "value": "it"
          }
        ],
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "p50 latency per route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "memes-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "memes-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(http_request_duration_seconds_bucket{env=\"$env\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
