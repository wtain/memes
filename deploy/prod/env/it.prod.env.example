# Keys of the production stack of environment "it" (copy to it.prod.env on the VPS, fill in, chmod 600, never commit the
# filled file). Used as  docker compose -p memes-it --env-file env/it.prod.env ...  A key left empty is a compose error where
# the key is required and falls back to the default in compose.yaml where it is optional. This example holds no value on purpose.
#
# Fixed by the environment table of the design (P5d):
#   MEMES_ENV=it  PG_PORT=6436  PROJECT_SUBNET=172.31.3.0/24  EDGE_ALIAS=api-it  PG_SHARED_BUFFERS=64MB (optional)
# SVC_GID is the gid of the host group memesync-it; SVC_UID defaults to 1000.
# BACKEND_TAG is the git sha the image was built from (never "latest").
# DATABASE_URL: role memes_it_app, host db, database memes_it  (postgresql+asyncpg://...@db:5432/memes_it).
# DATABASE_URL_OWNER: role memes_it_owner over the unix socket (...@/memes_it?host=/var/run/postgresql), used by migrate only.
# POSTGRES_PASSWORD: bootstrap superuser, used by the image entrypoint at the first start only.
# IMAGES_DIR /srv/memes/it/images, BUG_REPORTS_DIR /srv/memes/it/bug-reports, PGDATA_DIR /srv/memes/it/pgdata,
# PGCONF_DIR the rendered config directory (postgres/provision.sh render).
MEMES_ENV=
PROJECT_SUBNET=
PG_PORT=
EDGE_ALIAS=
SVC_UID=
SVC_GID=
BACKEND_TAG=
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_URL_OWNER=
IMAGES_DIR=
BUG_REPORTS_DIR=
PGDATA_DIR=
PGCONF_DIR=
# optional tuning (defaults in compose.yaml)
PG_SHARED_BUFFERS=
PG_MAX_CONNECTIONS=
DB_MEM_LIMIT=
DB_CPUS=
BACKEND_MEM_LIMIT=
BACKEND_CPUS=
MIGRATE_MEM_LIMIT=
MIGRATE_CPUS=
