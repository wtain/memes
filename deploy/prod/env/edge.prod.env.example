# Keys of the shared edge project (copy to edge.prod.env on the VPS, fill in, never commit the filled file). Used as
#   docker compose -p memes-edge --env-file ../env/edge.prod.env up -d     (from deploy/prod/edge)
# This example holds no value on purpose. Hostnames must resolve to the VPS before Caddy can obtain certificates.
ACME_EMAIL=
METAL_HOST=
GENERAL_HOST=
IT_HOST=
# host directories holding each environment's SPA build (/srv/memes/<env>/web), mounted read-only
WEB_ROOT_METAL=
WEB_ROOT_GENERAL=
WEB_ROOT_IT=
# optional tuning (defaults in edge/compose.yaml)
CADDY_MEM_LIMIT=
CADDY_CPUS=
