# Keys of the production stack of environment "metal" (copy to metal.prod.env on the VPS, fill in, chmod 600, never commit the
# filled file). Used as  docker compose -p memes-metal --env-file env/metal.prod.env ...  A key left empty is a compose error where
# the key is required and falls back to the default in compose.yaml where it is optional. This example holds no value on purpose.
#
# Fixed by the environment table of the design (P5d):
#   MEMES_ENV=metal  PG_PORT=6432  PROJECT_SUBNET=172.31.1.0/24  EDGE_ALIAS=api-metal  PG_SHARED_BUFFERS=256MB (optional)
# SVC_GID is the gid of the host group memesync-metal; SVC_UID defaults to 1000.
# BACKEND_TAG is the git sha the image was built from (never "latest").
# DATABASE_URL: role memes_metal_app, host db, database memes_metal  (postgresql+asyncpg://...@db:5432/memes_metal).
# DATABASE_URL_OWNER: role memes_metal_owner over the unix socket (...@/memes_metal?host=/var/run/postgresql), used by migrate only.
# POSTGRES_PASSWORD: bootstrap superuser, used by the image entrypoint at the first start only.
# IMAGES_DIR /srv/memes/metal/images, BUG_REPORTS_DIR /srv/memes/metal/bug-reports, PGDATA_DIR /srv/memes/metal/pgdata,
# PGCONF_DIR the rendered config directory (postgres/provision.sh render).
MEMES_ENV=
PROJECT_SUBNET=
PG_PORT=
EDGE_ALIAS=
SVC_UID=
SVC_GID=
BACKEND_TAG=
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_URL_OWNER=
IMAGES_DIR=
BUG_REPORTS_DIR=
PGDATA_DIR=
PGCONF_DIR=
# optional tuning (defaults in compose.yaml)
PG_SHARED_BUFFERS=
PG_MAX_CONNECTIONS=
DB_MEM_LIMIT=
DB_CPUS=
BACKEND_MEM_LIMIT=
BACKEND_CPUS=
MIGRATE_MEM_LIMIT=
MIGRATE_CPUS=
