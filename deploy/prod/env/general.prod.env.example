# Keys of the production stack of environment "general" (copy to general.prod.env on the VPS, fill in, chmod 600, never commit the
# filled file). Used as  docker compose -p memes-general --env-file env/general.prod.env ...  A key left empty is a compose error where
# the key is required and falls back to the default in compose.yaml where it is optional. This example holds no value on purpose.
#
# Fixed by the environment table of the design (P5d):
#   MEMES_ENV=general  PG_PORT=6434  PROJECT_SUBNET=172.31.2.0/24  EDGE_ALIAS=api-general  PG_SHARED_BUFFERS=256MB (optional)
# SVC_GID is the gid of the host group memesync-general; SVC_UID defaults to 10001 (a dedicated uid, not the first human account).
# BACKEND_TAG is the git sha the image was built from (never "latest").
# DATABASE_URL: role memes_general_app, host db, database memes_general  (postgresql+asyncpg://...@db:5432/memes_general).
# DATABASE_URL_OWNER: role memes_general_owner over the unix socket (...@/memes_general?host=/var/run/postgresql), used by migrate only.
# POSTGRES_PASSWORD: bootstrap superuser, used by the image entrypoint at the first start only.
# IMAGES_DIR /srv/memes/general/images, BUG_REPORTS_DIR /srv/memes/general/bug-reports, PGDATA_DIR /srv/memes/general/pgdata,
# PGCONF_DIR the rendered config directory (postgres/provision.sh render).
MEMES_ENV=
PROJECT_SUBNET=
PG_PORT=
EDGE_ALIAS=
SVC_UID=
SVC_GID=
BACKEND_TAG=
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_URL_OWNER=
IMAGES_DIR=
BUG_REPORTS_DIR=
PGDATA_DIR=
PGCONF_DIR=
# optional tuning (defaults in compose.yaml)
PG_SHARED_BUFFERS=
PG_MAX_CONNECTIONS=
DB_MEM_LIMIT=
DB_CPUS=
BACKEND_MEM_LIMIT=
BACKEND_CPUS=
MIGRATE_MEM_LIMIT=
MIGRATE_CPUS=
