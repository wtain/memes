# /etc/ssh/memes-keys/memesync-obs (the workstation's Grafana tunnel key, observability spec section 7). `ssh -N -L <port>:127.0.0.1:9090`
# reaches only Prometheus on the host loopback; a session on this key runs /bin/false. One account for all three environments.
restrict,port-forwarding,permitopen="127.0.0.1:9090",command="/bin/false" @KEY_TYPE@ @KEY_DATA@ memesync-obs-tunnel
