# Edge proxy of the production VPS (design: P5d, "Networks and Caddy" and "Log suppression per layer").
# One Caddy for the three environments. Hostnames come from the environment of the edge project (env/edge.prod.env).
# Verified with `caddy validate` on the pinned image (see README.md).
{
	email {$ACME_EMAIL}

	# The DEFAULT logger (everything that is not an access log: http.log.error entries of failed proxy requests, which carry
	# request>uri and request>headers) gets the same filter as the sites' access logs. Without it a 502 writes the searched text into the
	# container log (verified on the pinned image, see README "Log suppression"). `resp_headers` goes too: GET /api/images/<id> answers
	# with a Content-Disposition carrying the library file name, which can be a client-chosen upload name.
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>tls delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				resp_headers delete
			}
		}
	}

	# Request metrics of every server, served by the internal :9180 site below (edge network only, never published).
	metrics

	servers {
		# Header size limits (the request line counts as a header): a flood of oversized headers is refused early.
		max_header_size 16KB
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
	}
}

# Log format shared by every site: the full URI (it carries query strings: searched text) and every request header
# (Referer, Cookie, Authorization), the client address (remote_ip, remote_port, client_ip) and every response header (resp_headers: the
# Content-Disposition of an image carries its file name) are deleted; only the path is kept, as `path`.
# `path` is the one request field logged and may contain an image id (accepted: it is not a search text). No request bodies are ever logged.
(quiet_log) {
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>tls delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				resp_headers delete
			}
		}
	}
	# Second output: a size-bounded file (10 MiB x 5 kept, about 60 MB) with the SAME filter, so it cannot hold a query string, a header,
	# a cookie, a client address or a response header (remote_ip, remote_port, client_ip and resp_headers are deleted too). `access_file` is one logger shared by the three sites (their hosts merge into its include list).
	log access_file {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>tls delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				resp_headers delete
			}
		}
	}
	log_append path {http.request.uri.path}
	# The request id is the SERVER-generated one the backend returns as X-Request-ID (it ignores a client-sent id); empty for the SPA and
	# for anything Caddy answers itself. Read from the response, never from the request, so a client cannot choose what is logged.
	log_append request_id {http.response.header.X-Request-ID}
}

# Arguments: 1 = environment name (the SPA is /srv/memes/<env>/web), 2 = the backend's alias on memes-edge.
(memes_site) {
	import quiet_log

	encode zstd gzip

	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Second layer behind the backend's own stage policy: prefixes that are not mounted on prod are refused here too.
	# (handle blocks run in the order written and the first match wins, so these come before the proxy handles.)
	@unmounted path /api/admin* /api/uploads* /api/comics* /api/ingestion* /api/recut* /api/trends* /api/meme-from-text/ratings* /api/meme-from-text/profiles* /docs* /redoc* /openapi.json /metrics*
	handle @unmounted {
		respond 404
	}
	# GET /api/history (the search log) is dev only; POST /api/history/<id>/not-found stays.
	@history path_regexp ^/api/history/?$
	handle @history {
		respond 404
	}
	# The reader API has no PUT, PATCH or DELETE route on prod (Backend/app/stage_policy.py): refuse them here, before the proxy.
	@writes {
		path /api/*
		method PUT PATCH DELETE
	}
	handle @writes {
		respond 404
	}

	# File responses: sandbox the document, never sniff.
	@files path /api/images/*
	header @files Content-Security-Policy "sandbox; default-src 'none'"

	# Bug reports carry a screenshot: the one route with a larger body (11 MB).
	handle /api/bug-reports* {
		request_body {
			max_size 11MB
		}
		reverse_proxy {args[1]}:8000
	}

	handle /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy {args[1]}:8000
	}

	# Everything else is the SPA build, read-only from the host.
	handle {
		header Content-Security-Policy "frame-ancestors 'none'"
		root * /srv/memes/{args[0]}/web
		try_files {path} /index.html
		file_server
	}

	# Optional second gate in front of the whole site (off by default): uncomment, generate the hash with
	# `caddy hash-password`, keep it in the host's env file, never in this repository.
	# basic_auth {
	#	{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	# }
	# An allow-list works the same way: @denied not remote_ip <cidr> ... / respond @denied 403
}

{$METAL_HOST} {
	import memes_site metal api-metal
}

{$GENERAL_HOST} {
	import memes_site general api-general
}

{$IT_HOST} {
	import memes_site it api-it
}

# Internal metrics listener: Caddy's own metrics for the Prometheus of the memes-obs project (job caddy, caddy:9180 over the memes-edge
# network). Plain http, no TLS, never published (compose.yaml maps no 9180), and not reachable through any public hostname: the sites
# above answer /metrics with 404. The admin API stays on its default loopback address inside the container.
http://:9180 {
	metrics
}
