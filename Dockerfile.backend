# Multi-stage build for Backend service
FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY Backend/requirements-backend.txt .

# Create wheels
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip wheel --no-cache-dir --no-deps --wheel-dir /app/wheels -r requirements-backend.txt


# Final image
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy wheels from builder
COPY --from=builder /app/wheels /wheels
COPY --from=builder /app/requirements-backend.txt .

# Install Python dependencies
RUN pip install --no-cache-dir /wheels/* && \
    rm -rf /wheels

# Copy application code. Backend/app's own internal imports are absolute
# (e.g. `from Backend.app.api.diagnostics import ...`, matching how it's run
# locally: `uvicorn Backend.app.main:app` from the repo root) -- so Backend
# must be preserved as a package here too, not flattened to ./app.
COPY Backend/__init__.py ./Backend/__init__.py
COPY Backend/app ./Backend/app
COPY Storage ./Storage
COPY shared ./shared
COPY ai ./ai
COPY embeddingutils ./embeddingutils
COPY repository ./repository
COPY rules ./rules
COPY parse ./parse
COPY retrieval ./retrieval
COPY taxonomy ./taxonomy
# taxonomy.loader reads the vocabulary YAML from <repo>/batch/data/taxonomy (P3 parser needs it at query time).
COPY batch/data/taxonomy ./batch/data/taxonomy
COPY graph ./graph
COPY metrics ./metrics
COPY config ./config
COPY environments ./environments
# Backend/app/services/ingestion_service.py imports batch.clusterize for a
# shared constant (see docs/superpowers/specs/2026-07-25-duplicate-clustering-
# incremental-design.md). Copy only that module, not all of batch/ -- the rest
# is offline enrichment scripts (heavy ML deps not in requirements-backend.txt)
# plus batch/data, batch/downloads, batch/images*, which are data directories,
# not code, and don't belong in the image at all.
COPY batch/__init__.py ./batch/__init__.py
COPY batch/clusterize.py ./batch/clusterize.py
# batch/clusterize.py imports tracked_run/finish_existing_run from batch/run_tracking.py
# for its own self-tracking -- run_tracking.py itself only depends on repository/ and
# Storage/, both already copied above, so no further batch/ files are pulled in by this.
COPY batch/run_tracking.py ./batch/run_tracking.py
# Backend/app/services/admin_batch_service.py imports batch.registry.BatchRegistry
# to read environments/batch_registry*.yaml (already copied above).
COPY batch/registry.py ./batch/registry.py
# Backend/app/services/recut_adjust_service.py rebuilds a cut inside the request: it needs the cropper
# (batch/utils/recut_cut.py, which needs file_hash.py) and, through repository/cut_copier.py, the same module again.
COPY batch/utils/__init__.py ./batch/utils/__init__.py
COPY batch/utils/recut_cut.py ./batch/utils/recut_cut.py
COPY batch/utils/file_hash.py ./batch/utils/file_hash.py

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Run application with gunicorn (production) using uvicorn workers
CMD ["gunicorn", "Backend.app.main:app", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000"]