# Shell scripts must use LF on all platforms — CRLF breaks the shebang on Linux/macOS
.githooks/*     text eol=lf
*.sh            text eol=lf
docs/sync-registry.md text eol=lf
deploy/prod/** text eol=lf
Dockerfile.migrate text eol=lf
Dockerfile.migrate.dockerignore text eol=lf
deploy/** text eol=lf
