{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meme.schema.json",
  "title": "Meme",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "imageUrl": { "type": "string", "format": "url" },
    "originalFileName": { "type": "string" },
    "text": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "./memetag.schema.json"
      }
    },
    "excluded": {
      "type": "boolean",
      "description": "Whether the image has been marked as excluded"
    },
    "clusterId": {
      "type": "integer",
      "description": "Duplicate cluster ID, populated only in the duplicates endpoint"
    },
    "cosineDistance": {
      "type": "number",
      "description": "Cosine distance to the query image, populated only in the similar images endpoint"
    }
  },
  "required": ["id", "imageUrl"]
}