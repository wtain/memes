{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "memesearchresponse.schema.json",
  "title": "MemeSearchResponse",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "./meme.schema.json"
      }
    },
    "facets": {
      "type": "array",
      "items": {
        "$ref": "./facet.schema.json"
      }
    },
    "nextCursor": { "type": "string" },
    "hasNext": { "type": "boolean" },
    "previousCursor": { "type": "string" },
    "searchId": { "type": "string", "description": "Id of the search_history row of this search, when one was stored; absent for the browse feed or when outcome capture is off" }
  }
}