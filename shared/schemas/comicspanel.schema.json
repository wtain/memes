{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "comicspanel.schema.json",
  "title": "ComicsPanel",
  "description": "One panel of a comics; imageId is null when the source image is gone",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "position": {
      "type": "integer"
    },
    "imageId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceFilename": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "position",
    "imageId",
    "sourceFilename"
  ]
}
