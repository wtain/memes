{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "comicspage.schema.json",
  "title": "ComicsPage",
  "description": "One page of comics, newest first",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "./comicssummary.schema.json"
      }
    },
    "hasMore": {
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "hasMore"
  ]
}
