{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "batchprogress.schema.json",
  "title": "BatchProgress",
  "type": "object",
  "properties": {
    "label": { "type": ["string", "null"], "description": "The script or step name the counts belong to, e.g. build_image_embeddings" },
    "unit": { "type": ["string", "null"], "description": "What is being counted, e.g. images" },
    "done": { "type": ["integer", "null"] },
    "total": { "type": ["integer", "null"] },
    "rate_per_min": { "type": ["number", "null"] },
    "step": {
      "type": ["object", "null"],
      "properties": {
        "index": { "type": "integer" },
        "count": { "type": "integer" },
        "label": { "type": "string" }
      },
      "required": ["index", "count", "label"]
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["label", "unit", "done", "total", "rate_per_min", "step", "updated_at"]
}
