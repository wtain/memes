{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ingestionresolveresponse.schema.json",
  "title": "IngestionResolveResponse",
  "type": "object",
  "properties": {
    "rejected": { "type": "array", "items": { "type": "string" } },
    "kept": { "type": "array", "items": { "type": "string" } },
    "failed": { "type": "array", "items": { "$ref": "./ingestionfaileddecision.schema.json" } },
    "move_failed": { "type": "array", "items": { "$ref": "./ingestionmovefailure.schema.json" } }
  },
  "required": ["rejected", "kept", "failed", "move_failed"]
}
