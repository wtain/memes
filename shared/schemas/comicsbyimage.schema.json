{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "comicsbyimage.schema.json",
  "title": "ComicsByImage",
  "description": "The comics an image is a panel of, or null",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "comics": {
      "oneOf": [
        {
          "$ref": "./comicsbyimagecomics.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "comics"
  ]
}
