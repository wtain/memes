{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "comicscandidatepage.schema.json",
  "title": "ComicsCandidatePage",
  "description": "One page of open suggested comics, strongest first",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "./comicscandidate.schema.json"
      }
    },
    "hasMore": {
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "hasMore"
  ]
}
