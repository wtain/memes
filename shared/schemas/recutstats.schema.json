{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "recutstats.schema.json",
  "title": "RecutStats",
  "description": "Recut review statistics by detector-confidence band, with a total",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bands": { "type": "array", "items": { "$ref": "./recutstatsband.schema.json" } },
    "total": { "$ref": "./recutstatsband.schema.json" }
  },
  "required": ["bands", "total"]
}
