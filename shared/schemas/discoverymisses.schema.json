{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "discoverymisses.schema.json",
  "title": "DiscoveryMisses",
  "description": "Searches that ended without a save (discovery report, misses view)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["ok", "no_schema", "no_outcomes"] },
    "cutoff": { "type": ["string", "null"], "description": "Earliest linked save or press; older searches have no outcome data" },
    "gapMinutes": { "type": "integer" },
    "kind": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "category:value pairs" },
          "kind": { "type": "string" },
          "times": { "type": "integer" },
          "explicit": { "type": "integer" },
          "searches": { "type": "number" },
          "firstAt": { "type": "string" },
          "lastAt": { "type": "string" },
          "web": { "type": "integer" },
          "android": { "type": "integer" }
        },
        "required": ["query", "tags", "kind", "times", "explicit", "searches", "firstAt", "lastAt", "web", "android"]
      }
    }
  },
  "required": ["status", "cutoff", "gapMinutes", "kind", "items"]
}
