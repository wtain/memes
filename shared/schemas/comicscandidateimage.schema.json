{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "comicscandidateimage.schema.json",
  "title": "ComicsCandidateImage",
  "description": "One image of a suggested comics group",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "width": {
      "type": [
        "integer",
        "null"
      ]
    },
    "height": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "filename",
    "width",
    "height"
  ]
}
