{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ratingitem.schema.json",
  "title": "RatingItem",
  "description": "The grade given to one meme for one message",
  "type": "object",
  "properties": {
    "imageId": { "type": "string" },
    "grade": { "type": "integer", "minimum": 0, "maximum": 2 }
  },
  "required": ["imageId", "grade"]
}
